---
import BrandIcon from "@/components/BrandIcon.astro";
import AsciiScene from "@/components/AsciiScene.astro";
import { experience, profile, sideProjects } from "@/data/profile";
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout meta={{ title: "Home" }}>
	<div class="home-page">
		<AsciiScene />
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">Founder. Builder.<br /><span>Still curious.</span></h1>
			<p>I build thoughtful apps and the systems behind them at FlipFlop Labs.</p>
			<div class="intro-links">
				<a class="contact-link" href={profile.contact} target="_blank" rel="noopener noreferrer"
					>Contact</a
				>
				<a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</section>

		<section class="index-section studio-section" aria-labelledby="now-title">
			<h2 id="now-title" class="section-label">Now</h2>
			<div class="section-content">
				<h3 class="studio-title">
					<a href={profile.studio} target="_blank" rel="noopener noreferrer"
						><BrandIcon src="/favicons/flipflop.svg" />FlipFlop Labs</a
					>
				</h3>
				<p class="muted studio-description">My app studio. Thoughtful software.</p>
				<div class="studio-family">
					<div class="main-product family-branch">
						<h4>
							<a href="https://getbiu.app/" target="_blank" rel="noopener noreferrer"
								><BrandIcon src="/favicons/biu.ico" />biu</a
							>
						</h4>
						<p>Turn what you learn into lasting knowledge.</p>
						<p class="muted product-detail">AI flashcards &amp; spaced repetition.</p>
					</div>
					<div class="side-projects">
						<ul class="side-project-list" role="list">
							{
								sideProjects.map((project) => (
									<li class="family-branch">
										<h4>
											<a href={project.url} target="_blank" rel="noopener noreferrer">
												<BrandIcon src={project.icon} />
												{project.name}
											</a>
										</h4>
										<p class="muted">{project.description}</p>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="index-section experience-section" aria-labelledby="experience-title">
			<h2 id="experience-title" class="section-label">
				Past<br class="desktop-break" /> experience
			</h2>
			<ol class="experience-list section-content" role="list">
				{
					experience.map((job) => (
						<li class="experience-row">
							<div>
								<h3>
									<a href={job.url} target="_blank" rel="noopener noreferrer">
										<BrandIcon src={job.icon} />
										{job.company}
									</a>
								</h3>
								<p class="muted">{job.role}</p>
							</div>
							<p class="experience-dates">
								{job.start} <span aria-label="to">–</span> {job.end}
							</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="index-section past-projects-section" aria-labelledby="projects-title">
			<h2 id="projects-title" class="section-label">Past<br class="desktop-break" /> projects</h2>
			<div class="past-project section-content">
				<h3>
					<a href="https://phraze-web.vercel.app/" target="_blank" rel="noopener noreferrer"
						><BrandIcon src="/favicons/phraze.webp" />Phraze</a
					>
				</h3>
				<p class="muted">A collaborative publishing platform.</p>
			</div>
		</section>
	</div>
</PageLayout>
