---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { profile } from "@/data/profile";
---

<header class="site-header" id="main-header">
	<div class="identity">
		<a
			class="avatar-link"
			href="/"
			aria-label="Sanjib Sah — home"
			target="_blank"
			rel="noopener noreferrer"
		>
			<img src="/profile.png" alt="" width="48" height="48" fetchpriority="high" />
		</a>
		<div>
			<a class="identity-name" href="/" target="_blank" rel="noopener noreferrer">Sanjib Sah</a>
			<p class="identity-role">
				Founder at <a href={profile.studio} target="_blank" rel="noopener noreferrer"
					>FlipFlop Labs</a>
			</p>
		</div>
	</div>
	<div class="header-actions">
		<a class="resume-link" href={profile.resume} download="Sanjib-Sah-Resume.pdf">
			<span>Download résumé</span><Icon name="mdi:arrow-down" aria-hidden="true" />
		</a>
		<ThemeToggle />
	</div>
</header>
