---
import { Icon } from "astro-icon/components";
---

<theme-toggle>
	<button
		class="theme-button"
		type="button"
		role="switch"
		aria-checked="true"
		aria-label="Dark theme"
	>
		<Icon class="theme-sun" name="mdi:weather-sunny" aria-hidden="true" />
		<Icon class="theme-moon" name="mdi:weather-night" aria-hidden="true" />
	</button>
</theme-toggle>

<script>
	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>("button");
			if (!button) return;
			const sync = () => {
				button.setAttribute(
					"aria-checked",
					String(document.documentElement.dataset.theme === "dark"),
				);
			};
			sync();
			button.addEventListener("click", () => {
				document.dispatchEvent(
					new CustomEvent("theme-change", {
						detail: { theme: document.documentElement.dataset.theme === "dark" ? "light" : "dark" },
					}),
				);
			});
			document.addEventListener("theme-change", sync);
		}
	}
	if (!customElements.get("theme-toggle")) customElements.define("theme-toggle", ThemeToggle);
</script>
